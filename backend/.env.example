# Kopiere diese Datei zu .env und passe die Werte an

APP_NAME="TGA Plan Check API"
DEBUG=true

# SQLite-Datei relativ zum backend/-Ordner
DATABASE_URL="sqlite:///./data/tga_plan_check.db"

# Matching-Defaults
FUZZY_THRESHOLD_DEFAULT=85

# CORS — Frontend-Origin im Dev-Modus (JSON-Liste)
CORS_ORIGINS=["http://localhost:5173"]
